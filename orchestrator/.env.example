DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/satiq
REDIS_URL=redis://localhost:6379/0
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_SECURE=false
QWEN_BASE_URL=http://localhost:11434/v1
QWEN_API_KEY=ollama
QWEN_MODEL=qwen3.5:9b
MOCK_QWEN=true
# LLM switch: auto = try local Qwen (Ollama) if system can run it without crashing → Groq → mock
# Set to local / groq / mock to force, or auto to auto-detect (recommended)
LLM_PROVIDER=auto
GROQ_API_KEY=
# Two Groq keys for load distribution (rate-limit avoidance). Also supports GROQ_API_KEY1 / GROQ_API_KEY2.
GROQ_API_KEY1=
GROQ_API_KEY2=
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest
GROQ_MODEL=qwen/qwen3.6-27b
# GROQ_STT_MODEL=whisper-large-v3  # voice-to-text (Groq)
GROQ_STT_MODEL=whisper-large-v3
GROQ_BASE_URL=https://api.groq.com/openai/v1
ENABLE_VOICE=true
JWT_SECRET=change-me
ENV=development
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
API_HOST=0.0.0.0
API_PORT=8000
